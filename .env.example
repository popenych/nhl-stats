# Copy to .env and fill in for local/VPS deployment. Never commit the real .env.

# --- Backend ---
DATABASE_URL=sqlite+aiosqlite:///./data/db/nhl_stats.db
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
PHOTO_STORAGE_DIR=./data/photos
CORS_ORIGINS=http://localhost:5173

# --- Backups (Phase 5) ---
YANDEX_WEBDAV_URL=https://webdav.yandex.ru
YANDEX_WEBDAV_USER=
YANDEX_WEBDAV_APP_PASSWORD=
BACKUP_LOCAL_DIR=./data/backups
BACKUP_RETENTION_LOCAL=14
BACKUP_RETENTION_REMOTE=30

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000
