# Copy to .env and fill in for local/VPS deployment. Never commit the real .env.

# --- Backend ---
# Absolute paths matching docker-compose.yml's db-data/photo-data volume mount
# points — not the relative ./data/... paths used by local (non-Docker) dev.
DATABASE_URL=sqlite+aiosqlite:////data/db/nhl_stats.db
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
PHOTO_STORAGE_DIR=/data/photos
BACKUP_TRIGGER_PATH=/data/backup-trigger/run
CORS_ORIGINS=http://localhost:5173

# --- Backups (Phase 5) ---
# Yandex Disk app password — generate one at https://id.yandex.com/security/app-passwords
# (never your main account password). Used to build infra/rclone/rclone.conf;
# not read directly by the backup container (see infra/rclone/rclone.conf.example).
YANDEX_WEBDAV_URL=https://webdav.yandex.ru
YANDEX_WEBDAV_USER=
YANDEX_WEBDAV_APP_PASSWORD=
BACKUP_LOCAL_DIR=/data/backups
BACKUP_RETENTION_LOCAL=14
BACKUP_RETENTION_REMOTE=30
